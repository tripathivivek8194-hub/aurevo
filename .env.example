# =============================================================================
# AUREVO - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values
# Never commit .env to version control!
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
NODE_ENV=development
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000
# Public origin the store is served at. Leave EMPTY until you own a domain —
# canonical/og:url tags and sitemap URLs are omitted when unset (see useSeo).
# In production set WEB_URL to the same value (the edge nginx serves both).
SITE_URL=

# Note for docker compose production (docker-compose.prod.yml):
#   Set SITE_URL, POSTGRES_PASSWORD, REDIS_PASSWORD, ENCRYPTION_KEY and the
#   JWT / RAZORPAY secrets below. The compose file refuses to start without them.
PORT=4000

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://aurevo:aurevo_dev_password@localhost:5432/aurevo

# For Docker Compose (if using different credentials)
POSTGRES_USER=aurevo
POSTGRES_PASSWORD=aurevo_dev_password
POSTGRES_DB=aurevo

# -----------------------------------------------------------------------------
# Authentication (JWT)
# -----------------------------------------------------------------------------
# Generate secrets with: openssl rand -base64 32
# Access token: short-lived (15 min), stored in memory
JWT_ACCESS_SECRET=your-super-secret-access-key-generate-with-openssl-rand-base64-32
JWT_ACCESS_EXPIRY=15m

# Refresh token: long-lived (30 days), HttpOnly cookie, rotating
JWT_REFRESH_SECRET=your-super-secret-refresh-key-generate-with-openssl-rand-base64-32
JWT_REFRESH_EXPIRY=30d

# AES-256-GCM key for encrypting stored supplier credentials.
# Required in production (openssl rand -hex 32). Without it, at-rest
# encryption silently falls back to a hard-coded development key.
ENCRYPTION_KEY=

# Admin: Single store owner email (gets ADMIN role on first login)
ADMIN_EMAIL=owner@example.com

# -----------------------------------------------------------------------------
# Razorpay Payments (Test Mode)
# -----------------------------------------------------------------------------
# Get keys from: https://dashboard.razorpay.com/app/keys
# Test mode keys start with rzp_test_
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_from_razorpay_dashboard

# Google Sign-In
# The API verifies Google ID tokens against this OAuth web client ID.
GOOGLE_CLIENT_ID=

# -----------------------------------------------------------------------------
# AliExpress Open Platform
# -----------------------------------------------------------------------------
# Requires approved app at: https://open.aliexpress.com/
# Get credentials after app approval
ALIEXPRESS_APP_KEY=your_aliexpress_app_key
ALIEXPRESS_APP_SECRET=your_aliexpress_app_secret
ALIEXPRESS_ACCESS_TOKEN=your_aliexpress_access_token
ALIEXPRESS_TRACKING_URL=https://tracking.aliexpress.com/trackingdetail.htm?tradeId=
# Stable HTTPS URL that receives the AliExpress OAuth seller-auth callback.
# Required before the OAuth "Connect AliExpress" flow can run. No secrets here.
ALIEXPRESS_CALLBACK_URL=
# Optional — verification-time confirmation against official docs. Placeholders only.
# ALIEXPRESS_API_BASE_URL=
# ALIEXPRESS_AUTH_AUTHORIZE_URL=
# ALIEXPRESS_AUTH_TOKEN_URL=

# -----------------------------------------------------------------------------
# IndiaMART
# -----------------------------------------------------------------------------
# Get credentials from: https://seller.indiamart.com/
# Different APIs available: Lead Management, Catalog API
INDIAMART_CRM_ID=your_indiamart_crm_id
INDIAMART_API_KEY=your_indiamart_api_key

# -----------------------------------------------------------------------------
# Email (Transactional)
# -----------------------------------------------------------------------------
# Provider: resend | sendgrid | postmark | nodemailer (SMTP)
EMAIL_PROVIDER=resend
EMAIL_API_KEY=re_your_resend_api_key
EMAIL_FROM=noreply@aurevo.com
EMAIL_FROM_NAME=AUREVO

# SMTP Fallback (if using nodemailer)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your_smtp_user
# SMTP_PASS=your_smtp_password
# SMTP_SECURE=false

# -----------------------------------------------------------------------------
# Redis (Sessions, Rate Limiting, Cache)
# -----------------------------------------------------------------------------
# Local dev runs without a password. In production (docker-compose.prod.yml) a
# password is REQUIRED — REDIS_URL becomes redis://:<password>@redis:6379.
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# Frontend (Vite)
# -----------------------------------------------------------------------------
# Public site origin, baked into the static bundle at build time. Leave empty
# until a domain exists (canonical/og tags are then omitted).
VITE_SITE_URL=
VITE_API_URL=http://localhost:4000/api
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id
VITE_GOOGLE_CLIENT_ID=

# -----------------------------------------------------------------------------
# File Storage (Production)
# -----------------------------------------------------------------------------
# STORAGE_PROVIDER=local | s3 | minio
# STORAGE_LOCAL_PATH=./uploads
#
# S3 Configuration:
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
# AWS_S3_BUCKET=aurevo-uploads
# AWS_S3_ENDPOINT=  # Optional for S3-compatible (MinIO, DigitalOcean Spaces, etc.)

# -----------------------------------------------------------------------------
# Search (Optional - PostgreSQL FTS used by default)
# -----------------------------------------------------------------------------
# MEILISEARCH_HOST=http://localhost:7700
# MEILISEARCH_API_KEY=your_meilisearch_key

# -----------------------------------------------------------------------------
# Monitoring & Logging (Optional)
# -----------------------------------------------------------------------------
# LOG_LEVEL=debug
# SENTRY_DSN=
# DATADOG_API_KEY=

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------
ENABLE_SUPPLIER_SYNC=true
ENABLE_REVIEWS=true
ENABLE_WISHLIST=true
ENABLE_ANALYTICS=true

# =============================================================================
# GENERATION HELPERS
# =============================================================================
# Generate JWT secrets:
#   openssl rand -base64 32
#
# Generate Razorpay webhook secret:
#   openssl rand -hex 32
#
# Database password (if changing):
#   openssl rand -base64 16
# =============================================================================
